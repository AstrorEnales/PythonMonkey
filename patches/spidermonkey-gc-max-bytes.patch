+// JSGC_MAX_BYTES: like ConvertSize, except that UINT32_MAX (the largest value
+// the uint32_t parameter API can express, and what embedders pass to mean "as
+// large as possible") lifts the 4 GiB ceiling so 64-bit hosts can grow the GC
+// heap further. The limit is then JS_GC_MAX_MB megabytes when that environment
+// variable holds a positive integer, and unlimited otherwise.
+struct ConvertMaxBytes {
+  static uint32_t toUint32(size_t value) {
+    return value > UINT32_MAX ? UINT32_MAX : uint32_t(value);
+  }
+  static Maybe<size_t> fromUint32(uint32_t param) {
+    if (param != UINT32_MAX) {
+      return Some(size_t(param));
+    }
+    if (const char* env = getenv("JS_GC_MAX_MB")) {
+      char* end = nullptr;
+      unsigned long long mb = strtoull(env, &end, 10);
+      if (end != env && *end == '\0' && mb > 0 &&
+          mb <= SIZE_MAX / (1024 * 1024)) {
+        return Some(size_t(mb) * 1024 * 1024);
+      }
+    }
+    return Some(SIZE_MAX);
+  }
+};
+
 }  // anonymous namespace
 
